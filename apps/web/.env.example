# Project Brain web dashboard — server-side settings.
# Copy to .env.local (git-ignored) and fill in. Nothing here is sent to the
# browser: these are read only by server code.

# Brain API base URL. With both BRAIN_API_URL and BRAIN_API_KEY set the
# dashboard shows live data; with neither set it shows public demo data.
# Only one of the two set is a misconfiguration: the dashboard stays locked.
BRAIN_API_URL=https://brain.example.com
# API key, sent as the X-API-Key header from the server only.
BRAIN_API_KEY=

# Optional fixed sign-in, "user:password". Leave empty to manage the login from
# the dashboard (Settings → Access → Dashboard sign-in). When set, it wins and
# can't be changed there. With live data and no login configured anywhere, a
# dashboard listening on 127.0.0.1 (the npm run dev / start default) opens without
# a password; on any other address it stays locked (fail closed).
WEB_BASIC_AUTH=

# Address npm run dev / npm run start listen on (default 127.0.0.1 = this machine only).
# WEB_HOST=0.0.0.0

# true: with no login configured, let anyone in on any address (never on a public URL).
# false: lock even a loopback dashboard until a sign-in exists. Unset: open on loopback only.
# WEB_OPEN_MODE=

# Dashboard actions: 0 = off everywhere, 1 = on even without a password (only
# behind your own SSO). Default: on once a password protects the dashboard.
# BRAIN_WEB_ACTIONS=

# Optional IANA time zone for times shown on screen (default UTC).
# BRAIN_TIMEZONE=Europe/Minsk
