# Project Brain web dashboard — server-side settings.
# Copy to .env.local (git-ignored) and fill in. Nothing here is sent to the
# browser: these are read only by server code.

# Brain API base URL. With both BRAIN_API_URL and BRAIN_API_KEY set the
# dashboard shows live data; with either missing it shows demo data.
BRAIN_API_URL=https://brain.example.com
# API key, sent as the X-API-Key header from the server only.
BRAIN_API_KEY=

# Optional Basic-auth gate for the whole dashboard (see proxy.ts), "user:password".
# Leave empty to disable.
WEB_BASIC_AUTH=

# Optional IANA time zone for times shown on screen (default UTC).
# BRAIN_TIMEZONE=Europe/Minsk
