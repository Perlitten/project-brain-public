{
  "id": "PBNightlyHealth1",
  "name": "Nightly Harness Health",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "schedule-nightly-health",
      "name": "Nightly 02:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 180]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "execute-health",
      "name": "Harness Execute Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PROJECT_BRAIN_API_URL || 'http://api:8000' }}/jobs/health-check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PROJECT_BRAIN_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "enqueue-health",
      "name": "Enqueue Harness Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "amount": 15
      },
      "id": "wait-health",
      "name": "Wait for Health Worker",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [560, 300]
    },
    {
      "parameters": {
        "url": "={{ ($env.PROJECT_BRAIN_API_URL || 'http://api:8000') + '/jobs/' + ($json.job_id || $json.id) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PROJECT_BRAIN_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "check-health",
      "name": "Check Health Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "health-completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-health-completed",
      "name": "Health Job Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "health-failed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-health-failed",
      "name": "Health Job Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1280, 420]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'Health job failed after retries: ' + ($json.error || $json.id) }}"
      },
      "id": "fail-health-workflow",
      "name": "Fail Health Workflow",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1520, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "health-result-healthy",
              "leftValue": "={{ $json.result?.healthy }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-health-result-healthy",
      "name": "Harness Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1280, 180]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'Harness health probes completed but reported unhealthy: ' + JSON.stringify($json.result || {}) }}"
      },
      "id": "fail-unhealthy-result",
      "name": "Fail Unhealthy Result",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1520, 200]
    }
  ],
  "connections": {
    "Nightly 02:00 UTC": {
      "main": [
        [
          {
            "node": "Enqueue Harness Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Harness Execute Trigger": {
      "main": [
        [
          {
            "node": "Enqueue Harness Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enqueue Harness Health": {
      "main": [
        [
          {
            "node": "Wait for Health Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Health Worker": {
      "main": [
        [
          {
            "node": "Check Health Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Health Job": {
      "main": [
        [
          {
            "node": "Health Job Completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health Job Completed?": {
      "main": [
        [
          {
            "node": "Harness Healthy?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Health Job Failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health Job Failed?": {
      "main": [
        [
          {
            "node": "Fail Health Workflow",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for Health Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Harness Healthy?": {
      "main": [
        [],
        [
          {
            "node": "Fail Unhealthy Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionTimeout": 7200
  },
  "staticData": null,
  "tags": [
    {
      "name": "project-brain"
    },
    {
      "name": "production"
    },
    {
      "name": "closed-loop"
    }
  ]
}
