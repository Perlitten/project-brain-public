{
  "id": "PBGitMergeRdx01",
  "name": "Git Push → Reindex",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "git-merge",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "git-push-webhook",
      "name": "Git Push Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "git-merge-reindex"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "token-match",
              "leftValue": "={{ $json.headers?.['x-project-brain-token'] || '' }}",
              "rightValue": "={{ $env.PROJECT_BRAIN_WEBHOOK_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "master-ref",
              "leftValue": "={{ $json.body?.ref || '' }}",
              "rightValue": "refs/heads/master",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "authorize-push",
      "name": "Authorize Master Push",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "Unauthorized or unexpected Project Brain push webhook"
      },
      "id": "reject-push",
      "name": "Reject Push",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [520, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PROJECT_BRAIN_API_URL || 'http://api:8000' }}/jobs/reindex",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PROJECT_BRAIN_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ clean: false, repo_path: $json.body?.repo_path || $env.PROJECT_BRAIN_GIT_REPO_PATH || '/app', source_revision: $json.body?.sha || $json.body?.after || '', verify_after: true, benchmark_after: true, idempotency_key: 'git-reindex:' + ($json.body?.sha || $json.body?.after || $execution.id) }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "enqueue-reindex",
      "name": "Enqueue Durable Reindex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 260]
    },
    {
      "parameters": {
        "amount": 20
      },
      "id": "wait-reindex",
      "name": "Wait for Reindex Worker",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [820, 260]
    },
    {
      "parameters": {
        "url": "={{ ($env.PROJECT_BRAIN_API_URL || 'http://api:8000') + '/jobs/' + ($json.job_id || $json.id) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PROJECT_BRAIN_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "check-reindex",
      "name": "Check Reindex Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "reindex-completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-reindex-completed",
      "name": "Reindex Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1300, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "reindex-failed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-reindex-failed",
      "name": "Reindex Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1540, 380]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'Reindex job failed after retries: ' + ($json.error || $json.id) }}"
      },
      "id": "fail-reindex-workflow",
      "name": "Fail Reindex Workflow",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1780, 320]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "reindex-ok",
              "name": "completed",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "reindex-job-id",
              "name": "job_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "reindex-commit",
              "name": "indexed_revision",
              "value": "={{ $json.result?.commit_hash || '' }}",
              "type": "string"
            },
            {
              "id": "embedding-pass",
              "name": "embedding_verification_passed",
              "value": "={{ $json.result?.embedding_verification?.pass === true }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "record-reindex-success",
      "name": "Record Reindex Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1540, 140]
    }
  ],
  "connections": {
    "Git Push Webhook": {
      "main": [
        [
          {
            "node": "Authorize Master Push",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorize Master Push": {
      "main": [
        [
          {
            "node": "Enqueue Durable Reindex",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Push",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enqueue Durable Reindex": {
      "main": [
        [
          {
            "node": "Wait for Reindex Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Reindex Worker": {
      "main": [
        [
          {
            "node": "Check Reindex Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Reindex Job": {
      "main": [
        [
          {
            "node": "Reindex Completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reindex Completed?": {
      "main": [
        [
          {
            "node": "Record Reindex Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reindex Failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reindex Failed?": {
      "main": [
        [
          {
            "node": "Fail Reindex Workflow",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for Reindex Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionTimeout": 21600
  },
  "staticData": null,
  "tags": [
    {
      "name": "project-brain"
    },
    {
      "name": "production"
    },
    {
      "name": "closed-loop"
    }
  ]
}
