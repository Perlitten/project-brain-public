{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-brain.local/schemas/paired-retrieval-dataset-v1.json",
  "title": "Project Brain paired retrieval evaluation dataset",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "question",
      "expect_files",
      "why",
      "language",
      "query_class",
      "provenance"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "expect_files": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "why": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "language": {
        "type": "string",
        "enum": ["en", "ru", "ru-en"]
      },
      "query_class": {
        "type": "string",
        "enum": [
          "exact_identifier",
          "cross_file",
          "bug",
          "conceptual",
          "ru_to_en",
          "adversarial"
        ]
      },
      "split": {
        "type": "string",
        "enum": ["tune", "holdout"]
      },
      "trap_files": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source", "production_real"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "curated",
              "curated_translation",
              "curated_synthetic",
              "anonymized_production"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "production_real": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "query_class": {
              "const": "adversarial"
            }
          },
          "required": ["query_class"]
        },
        "then": {
          "required": ["trap_files"]
        }
      }
    ]
  }
}
