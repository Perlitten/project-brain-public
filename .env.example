# Project Brain - copy to .env and adjust for your environment

# --- Core ---
ENVIRONMENT=local
REPO_ROOT=.
# Writable generated-artifact store. Keep this outside read-only indexed repos.
CONTEXT_PACK_OUTPUT_DIR=./context_packs
# Product repo indexed by `brain index` / `brain embeddings verify` (override with --repo).
# For local quick start this can stay `.`; for real use, point it to the repo
# you want Project Brain to index.
TARGET_REPO_PATH=.

# --- Bounded repository indexing ---
INDEX_FILE_CONCURRENCY=4
INDEX_PROVIDER_CONCURRENCY=2
INDEX_EMBEDDING_BATCH_SIZE=8
INDEX_GRAPH_BATCH_SIZE=256
INDEX_PROGRESS_INTERVAL_SECONDS=10
INDEX_REPAIR_CHUNK_LIMIT=500

# --- Agent v2 rollout (off is the one-switch rollback position) ---
# `persist=false` on /context is always ephemeral; these flags only govern
# opt-in v2 locator/ask/impact paths and worker-pool services.
BRAIN_AGENT_CONTEXT_V2_MODE=off
BRAIN_WORKER_POOLS_V2_ENABLED=false
AGENT_LOCATOR_MAX_BYTES=2400
AGENT_RUNTIME_CONTEXT_MAX_BYTES=14000
AGENT_ASK_INPUT_MAX_BYTES=18000
AGENT_ASK_OUTPUT_MAX_BYTES=2000
AGENT_IMPACT_MAX_BYTES=8000
AGENT_RETRIEVAL_DEADLINE_S=5
AGENT_CONTEXT_DEADLINE_S=8
AGENT_ASK_DEADLINE_S=25
AGENT_IMPACT_DEADLINE_S=10

# Production server_up.sh requires a successful run of this workflow for the
# exact immutable release SHA. Leave unset for local development.
BRAIN_GITHUB_REPOSITORY=
BRAIN_GITHUB_CI_WORKFLOW=ci.yml

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=brain_db

# --- Redis (worker queue uses WORKER_REDIS_PREFIX on db 0) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# --- LLM / Embeddings (use mock for local dev without API keys) ---
# Providers: mock | anthropic | google | any OpenAI-compatible API, either as a
# preset (openai, nvidia, openrouter, groq, together, deepseek, mistral, ollama,
# lmstudio) or as a generic endpoint: openai_compatible (aliases: custom,
# openai-compatible). Presets only supply defaults; the universal settings
# below override them for the provider selected here.
DEFAULT_LLM_PROVIDER=mock
DEFAULT_EMBEDDING_PROVIDER=mock

# Universal OpenAI-compatible settings (all optional for presets; required
# base URL + model for openai_compatible). URLs must include the API version
# path (".../v1"); "/chat/completions" and "/embeddings" are appended.
# LLM_BASE_URL=
# Omit for keyless local endpoints (Ollama, LM Studio, vLLM):
# LLM_API_KEY=
# Main / synthesis model:
# LLM_MODEL=
# Cheaper model for summaries/classification (default: LLM_MODEL):
# SUMMARIZER_MODEL=
# Default: LLM_BASE_URL when both use the same provider:
# EMBEDDING_BASE_URL=
# Default: LLM_API_KEY when both use the same provider:
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# REQUIRED for non-preset embedding models; must match the DB column:
# EMBEDDING_DIMENSION=
# Per-input char cap (0/blank = preset or unlimited):
# EMBEDDING_MAX_INPUT_CHARS=
# Inputs per request (0/blank = preset or 64):
# EMBEDDING_BATCH_SIZE=
#
# Example - OpenRouter (chat only; keep embeddings on another provider):
#   DEFAULT_LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   LLM_MODEL=anthropic/claude-3.5-sonnet
# Example - Groq:
#   DEFAULT_LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
#   SUMMARIZER_MODEL=llama-3.1-8b-instant
# Example - Ollama (local, no key; 768-dim nomic-embed-text):
#   DEFAULT_LLM_PROVIDER=ollama
#   DEFAULT_EMBEDDING_PROVIDER=ollama
#   LLM_MODEL=llama3.1
# Example - any other endpoint (vLLM, LiteLLM, Fireworks, ...):
#   DEFAULT_LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.fireworks.ai/inference/v1
#   LLM_API_KEY=...
#   LLM_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# Preset-specific API keys (used when LLM_API_KEY is blank)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
NVIDIA_API_KEY=

# NVIDIA NIM preset (DEFAULT_*_PROVIDER=nvidia): legacy model settings, still
# honoured. Embeddings are 4096-dim; switching embedding provider/model
# requires a full re-index.
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedcode-7b-v1
NVIDIA_SUMMARIZER_MODEL=meta/llama-3.1-8b-instruct

# Optional LFM2.5-ColBERT late-interaction canary.  These defaults do not call
# the sidecar, do not dual-write and never affect ranking.
LATE_INTERACTION_ENABLED=false
LATE_INTERACTION_DUAL_WRITE_ENABLED=false
LATE_INTERACTION_SHADOW_ENABLED=false
LATE_INTERACTION_SHADOW_PERSIST_ENABLED=true
LATE_INTERACTION_RERANK_ENABLED=false
LATE_INTERACTION_CANARY_PERCENT=0
# Explicit release-time authorizations. Experiment authorization permits only
# release-bound dual-write/shadow work; it never authorizes user-visible
# ranking. Production approval is separately required for rerank/canary.
LATE_INTERACTION_EXPERIMENT_AUTHORIZED=false
LATE_INTERACTION_PRODUCTION_GATES_PASSED=false
LATE_INTERACTION_APPROVED_REPOSITORY_ID=
LATE_INTERACTION_APPROVED_BUILD_SHA=
LATE_INTERACTION_APPROVED_SOURCE_DIGEST=
LATE_INTERACTION_APPROVED_MODEL_REVISION=
LATE_INTERACTION_APPROVED_INDEX_REVISION=
LATE_INTERACTION_APPROVED_LINEAGE_ID=
LATE_INTERACTION_APPROVED_IDENTITY_DIGEST=
LATE_INTERACTION_APPROVED_DOCUMENT_COUNT=
LATE_INTERACTION_PRODUCTION_EVIDENCE_PATH=
LATE_INTERACTION_PRODUCTION_EVIDENCE_SHA256=
LATE_INTERACTION_PROVIDER_URL=http://127.0.0.1:8089
LATE_INTERACTION_ALLOW_REMOTE_PROVIDER=false
LATE_INTERACTION_MODEL=LiquidAI/LFM2.5-ColBERT-350M-GGUF
LATE_INTERACTION_MODEL_REVISION=bc240003aba07253e261a8aaf0d2c9683318a967
LATE_INTERACTION_DIMENSION=128
LATE_INTERACTION_QUERY_MAX_TOKENS=32
LATE_INTERACTION_DOCUMENT_MAX_TOKENS=512
LATE_INTERACTION_TIMEOUT_S=20
LATE_INTERACTION_RERANK_TIMEOUT_S=2
LATE_INTERACTION_DUAL_WRITE_TIMEOUT_S=5
LATE_INTERACTION_DUAL_WRITE_MAX_CONSECUTIVE_FAILURES=3
LATE_INTERACTION_RERANK_LIMIT=50
LATE_INTERACTION_MAX_RERANK_CHUNKS=500
LATE_INTERACTION_MIN_CANDIDATE_COVERAGE=1.0
LATE_INTERACTION_SCORE_WEIGHT=0.25
LATE_INTERACTION_STORAGE_DTYPE=float16
LATE_INTERACTION_REMOTE_ENABLED=false
LATE_INTERACTION_REMOTE_URL=http://127.0.0.1:8090
LATE_INTERACTION_REMOTE_TOKEN=
LATE_INTERACTION_REMOTE_MODEL=LiquidAI/LFM2.5-ColBERT-350M
LATE_INTERACTION_REMOTE_MODEL_REVISION=59633c2e31717b3502343ff566bee9fda3261943
LATE_INTERACTION_REMOTE_TIMEOUT_S=2
LATE_INTERACTION_REMOTE_MUTATION_TIMEOUT_S=120
LATE_INTERACTION_REMOTE_MAX_CANDIDATES=500
LATE_INTERACTION_REMOTE_MAX_DOCUMENTS=64
LATE_INTERACTION_REMOTE_SYNC_BATCH_SIZE=64
LATE_INTERACTION_REMOTE_SOURCE_PAGE_SIZE=256
LATE_INTERACTION_REMOTE_MAX_PAYLOAD_BYTES=2000000
LATE_INTERACTION_SEARCH_CANDIDATE_LIMIT=50
LATE_INTERACTION_REMOTE_EXPECTED_INDEX_REVISION=
LATE_INTERACTION_REMOTE_ALLOW_EMPTY_CONTENT_HASH=false
# Authenticated asynchronous quality-first lane. It never changes default
# /ask, /search or /context traffic; only worker jobs can opt into it.
LATE_INTERACTION_DEEP_ENABLED=false
LATE_INTERACTION_DEEP_TIMEOUT_S=120
LATE_INTERACTION_DEEP_VECTOR_LIMIT=200
LATE_INTERACTION_DEEP_NOTIFY=true
NIGHTLY_DEEP_MAINTENANCE_ENABLED=false
NIGHTLY_DEEP_MAINTENANCE_REPO_PATH=/app
NIGHTLY_DEEP_MAINTENANCE_NOTIFY=true
NIGHTLY_DEEP_MAINTENANCE_QUALITY_QUERIES=3
# GPU service process (uvicorn --factory
# brain.late_interaction.gpu_service:create_app_from_env).
LATE_INTERACTION_SERVICE_ENV=production
LATE_INTERACTION_SERVICE_DATABASE_PATH=./data/late-interaction.sqlite3
LATE_INTERACTION_SERVICE_TOKEN=
LATE_INTERACTION_SERVICE_MODEL=LiquidAI/LFM2.5-ColBERT-350M
LATE_INTERACTION_SERVICE_MODEL_REVISION=59633c2e31717b3502343ff566bee9fda3261943
LATE_INTERACTION_SERVICE_DIMENSION=128
LATE_INTERACTION_SERVICE_QUERY_MAX_TOKENS=32
LATE_INTERACTION_SERVICE_DOCUMENT_MAX_TOKENS=512
LATE_INTERACTION_SERVICE_MAX_CANDIDATES=500
LATE_INTERACTION_SERVICE_MAX_DOCUMENTS=64
LFM_LICENSE_ACKNOWLEDGED=false

# Per-task model routing (used by ModelRouter). Optional: when blank, synthesis
# uses LLM_MODEL / the preset's main model and the other tasks use
# SUMMARIZER_MODEL / the preset's small model (nvidia: 70b / 8b as before).
# Model IDs are provider-specific - set these only for the active provider.
# LLM_TASK_CLASSIFICATION_MODEL=meta/llama-3.1-8b-instruct
# LLM_TASK_SUMMARIZATION_MODEL=meta/llama-3.1-8b-instruct
# LLM_TASK_SYNTHESIS_MODEL=meta/llama-3.1-70b-instruct
# LLM_TASK_INSIGHT_MODEL=meta/llama-3.1-8b-instruct

# Proactive insight loop. Manual /jobs/proactive-insights works either way;
# PROACTIVE_INSIGHTS_ENABLED is for scheduled runs.
PROACTIVE_INSIGHTS_ENABLED=false
PROACTIVE_INSIGHTS_LLM_ENABLED=false
PROACTIVE_INSIGHTS_MAX_SNAPSHOT_CHARS=16000
PROACTIVE_INSIGHTS_TIMEOUT_S=75
PROACTIVE_INSIGHTS_LLM_CACHE_TTL_SECONDS=0

# --- Orchestration API (required in production; send the X-API-Key header) ---
PROJECT_BRAIN_API_KEY=change-me-in-production
PROJECT_BRAIN_WEBHOOK_TOKEN=change-me-to-a-random-64-character-token
WORKER_REDIS_PREFIX=brain:worker
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_MAX_JOB_TIMEOUT_SECONDS=21600
WORKER_HEARTBEAT_TTL_SECONDS=45
# Min seconds between stale_blocked-triggered auto-reindexes of one repo.
AUTO_REINDEX_MIN_INTERVAL_S=3600
HARNESS_STALE_REAPER_ENABLED=true
HARNESS_STALE_REAPER_BATCH_SIZE=500

# --- Closed-loop LLM self-diagnosis and owner alerts ---
SELF_DIAGNOSIS_ENABLED=false
SELF_DIAGNOSIS_USE_LLM=true
SELF_DIAGNOSIS_JOB_MAX_ATTEMPTS=3
SELF_DIAGNOSIS_RESULT_TTL_SECONDS=604800
SELF_DIAGNOSIS_MIN_AVG_RECALL=0.70
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=21600
TELEGRAM_ALERT_TIMEOUT_S=20
BRAIN_TELEGRAM_DEFAULT_REPO=

# --- Scheduler (runs inside the worker; see docs/adr/013-worker-scheduler.md) ---
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_CATCHUP_WINDOW_S=21600
SCHEDULER_STALE_GRACE_S=7200
SCHEDULER_JOB_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_S=5
WORKER_RETRY_MAX_DELAY_S=300
# Optional dead-man switch URLs (e.g. https://hc-ping.com/<uuid>), pinged on success.
DEADMAN_URL_NIGHTLY_MAINTENANCE=
DEADMAN_URL_HEALTH_CHECK=
DEADMAN_URL_SELF_DIAGNOSIS=
DEADMAN_URL_BENCHMARK=
# Repo reindexed by POST /webhooks/git-merge and maintained nightly.
PROJECT_BRAIN_GIT_REPO_PATH=/app

# --- External integrations ---
# Grafify graph JSON export (default: ../graphify-out/graph.json relative to REPO_ROOT)
GRAFIFY_OUTPUT_PATH=

# Obsidian vault for `brain import obsidian` (or pass --vault on the CLI).
# Must be the vault root directory that contains a `.obsidian/` config folder.
# Verify on Windows: Test-Path "$env:OBSIDIAN_VAULT_PATH\.obsidian" -> True
# Example: OBSIDIAN_VAULT_PATH=/path/to/Obsidian
OBSIDIAN_VAULT_PATH=

# --- Retrieval tuning (single-user local) ---
ALLOW_EMBEDDING_JSON_FALLBACK=false
RETRIEVAL_USE_LLM_CLASSIFICATION=false
CONTEXT_PACK_SKIP_PLAN_LLM=false

# --- Browser automation (optional eval scaffold; see eval/browser_automation/) ---
BROWSER_HEADLESS=true
# BROWSER_SMOKE_URL=https://example.com
# Dedicated model for bounded /ask; unset preserves the synthesis route.
LLM_TASK_ASK_MODEL=
# Set only for a supported Nemotron model; unset = provider default.
LLM_TASK_ASK_ENABLE_THINKING=
