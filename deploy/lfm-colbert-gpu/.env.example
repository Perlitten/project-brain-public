# Bind only to loopback or a private VPN address. Never use 0.0.0.0.
LFM_SERVICE_BIND_ADDRESS=127.0.0.1
LFM_SERVICE_PORT=8090
LFM_GPU_IMAGE_TAG=pylate-1.4.0

# Generate independently from Project Brain API keys:
#   openssl rand -hex 32
LATE_INTERACTION_SERVICE_TOKEN=

# Pin these after the first verified full synchronization.
LATE_INTERACTION_SERVICE_APPROVED_REPOSITORY_ID=
LATE_INTERACTION_SERVICE_MINIMUM_INDEX_REVISION=
LATE_INTERACTION_SERVICE_MINIMUM_DOCUMENT_COUNT=0

# Set true only after reviewing LFM Open License v1.0.
LFM_LICENSE_ACKNOWLEDGED=false

LATE_INTERACTION_SERVICE_ENCODER_BATCH_SIZE=16
LATE_INTERACTION_SERVICE_SCORE_BATCH_SIZE=32
LATE_INTERACTION_SERVICE_MAX_CONCURRENCY=2
LFM_SERVICE_MEMORY_LIMIT=8g
