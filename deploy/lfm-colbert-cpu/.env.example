# Matrix/rerank service is published only on loopback by default.
LFM_CPU_SERVICE_BIND_ADDRESS=127.0.0.1
LFM_CPU_SERVICE_PORT=8094

# Generate independently from Project Brain API keys:
#   openssl rand -hex 32
LATE_INTERACTION_SERVICE_TOKEN=

# Leave blank/zero only while building an inert index. After a verified full
# sync, pin the repository, revision floor, and minimum corpus size here.
LATE_INTERACTION_SERVICE_APPROVED_REPOSITORY_ID=
LATE_INTERACTION_SERVICE_MINIMUM_INDEX_REVISION=
LATE_INTERACTION_SERVICE_MINIMUM_DOCUMENT_COUNT=0

# Set true only after reviewing LFM Open License v1.0.
LFM_LICENSE_ACKNOWLEDGED=false

# Quality is unchanged by these conservative background CPU caps. They leave
# capacity for the Brain API, database, worker and operator access.
LFM_CPU_LLAMA_THREADS=2
LFM_CPU_LLAMA_THREADS_BATCH=2
LFM_CPU_LLAMA_CPUS=2.0
LFM_CPU_LLAMA_MEMORY_LIMIT=3g
LFM_CPU_LLAMA_TIMEOUT_S=60

LFM_CPU_SCORE_BATCH_SIZE=32
LFM_CPU_SCORE_THREADS=2
LFM_CPU_SERVICE_MAX_CONCURRENCY=1
LFM_CPU_SERVICE_CPUS=1.0
LFM_CPU_SERVICE_MEMORY_LIMIT=2g
