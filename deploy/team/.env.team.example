# Project Brain - one team on one host. Template only: no real secrets here.
#
# Start from deploy/.env.prod.example (model providers, LFM gate, CI gate),
# then merge the keys below into the repository-root .env: where a key is
# already there, edit that line rather than adding a second one (server_up.sh
# reads the first copy of a key). Fill every blank secret with a fresh random
# value, for example `openssl rand -hex 32`.
# Guide: docs/operations/TEAM_DEPLOY.md.

# --- Hosts and TLS (deploy/team/docker-compose.team.yml, deploy/team/Caddyfile) ---
# Both names must resolve to this server; ports 80 and 443 must be open.
BRAIN_WEB_DOMAIN=brain.example.com
BRAIN_API_DOMAIN=api.brain.example.com
BRAIN_ACME_EMAIL=ops@example.com

# --- Core secrets (required; blank values keep the stack from starting) ---
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# The server key. The API accepts it only while the Brain is solo; once the
# team has members everyone uses a named key. The dashboard also seals member
# cookies with it, so rotating it signs every member out.
PROJECT_BRAIN_API_KEY=
PROJECT_BRAIN_WEBHOOK_TOKEN=
# Optional extra lock on the dashboard while it is solo (user:password).
WEB_BASIC_AUTH=
BRAIN_TIMEZONE=UTC

# --- Sources (origin polling, #135) ---
# Origin of a source that has none (read-only mounts), JSON object
# path -> URL or path -> {"url": ..., "branch": ...}. Example:
# BRAIN_ORIGIN_REMOTES={"/indexed/core": {"url": "https://github.com/acme/core.git"}}
BRAIN_ORIGIN_REMOTES=
BRAIN_ORIGIN_POLL_INTERVAL_S=300
# Host directory holding the checkouts the Brain indexes (mounted at /indexed).
BRAIN_INDEXED_PROJECTS_DIR=./indexed-projects

# --- Team sign-in with SSO (docs/operations/TEAM_SSO.md) ---
# Register https://<BRAIN_WEB_DOMAIN>/auth/oidc/callback at your provider.
BRAIN_OIDC_ENABLED=false
BRAIN_OIDC_ISSUER=
BRAIN_OIDC_CLIENT_ID=
BRAIN_OIDC_CLIENT_SECRET=
# Blank: <BRAIN_WEB_URL>/auth/oidc/callback (the overlay sets BRAIN_WEB_URL).
BRAIN_OIDC_REDIRECT_URI=
BRAIN_OIDC_SCOPES="openid email profile"
BRAIN_OIDC_ALLOWED_EMAIL_DOMAINS=
BRAIN_OIDC_REQUIRE_FOR_INVITATIONS=false

# --- Bounded execution (docs/operations/TEAM_EXECUTION.md) ---
# The API needs the switch to accept execution requests; only the
# worker-executor (compose profile "executor") runs them. With the profile on,
# stop the plain worker: BRAIN_PLAIN_WORKER_REPLICAS=0.
BRAIN_EXECUTION_ENABLED=false
BRAIN_EXECUTION_ROOT=/var/lib/brain/executions
# Host directory for working copies, owned by uid 999.
BRAIN_EXECUTION_HOST_DIR=./executions
BRAIN_EXECUTION_TOOLS={}
# Reference -> name of a server environment variable holding the value.
BRAIN_EXECUTION_SECRETS={}
BRAIN_EXECUTION_EGRESS=
BRAIN_PLAIN_WORKER_REPLICAS=1

# --- Backups (read by `brain team doctor`) ---
# Host directory deploy/server_up.sh writes pg_dump backups to; mounted
# read-only at /backups.
BRAIN_BACKUP_HOST_DIR=./backups
# The same directory as the containers see it (the overlay mounts it there).
BRAIN_BACKUP_DIR=/backups
BRAIN_BACKUP_MAX_AGE_HOURS=48
