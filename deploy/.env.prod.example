# Project Brain - PRODUCTION env template.
# Copy to .env on the server. Secrets are generated by deploy/server_up.sh if absent.
# NEVER commit a filled-in version of this file.

ENVIRONMENT=production
REPO_ROOT=/app
# Repo indexed by the running service (mounted read-only at /repo). Override per host.
TARGET_REPO_PATH=/repo
# Public hosts. For a bare IP VPS without DNS, nip.io works:
#   BRAIN_PUBLIC_HOST=brain.<server-ip>.nip.io
BRAIN_PUBLIC_HOST=brain.REPLACE_WITH_SERVER_IP.nip.io

# Host directories mounted read-only into the API/worker containers.
# Put the repo you want indexed in BRAIN_TARGET_REPO_DIR, or mount a parent
# directory of several repos at BRAIN_INDEXED_PROJECTS_DIR and index /indexed/<repo>.
BRAIN_TARGET_REPO_DIR=./target-repo
BRAIN_INDEXED_PROJECTS_DIR=./indexed-projects

# --- PostgreSQL (internal to the compose network; not published to the host) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# Strong password - generated by server_up.sh (openssl rand) if left blank.
POSTGRES_PASSWORD=
POSTGRES_DB=brain_db
# Two long-lived processes (API and worker) each own a pool. These defaults cap
# the combined application maximum at 40 connections, leaving headroom under
# PostgreSQL's standard 100-connection limit.
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT_SECONDS=15

# --- Redis (internal) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Neo4j (internal) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# Strong password - generated by server_up.sh if left blank.
NEO4J_PASSWORD=

# --- API exposure (loopback only; nginx terminates TLS) ---
BRAIN_API_PORT=8010

# --- Immutable release gate ---
# server_up.sh queries this canonical GitHub Actions workflow for the exact
# .project-brain-release SHA and refuses a missing, pending, or red run.
# Use the repository you deploy from (your fork, if you forked it).
BRAIN_GITHUB_REPOSITORY=Perlitten/project-brain-public
BRAIN_GITHUB_CI_WORKFLOW=ci.yml
# Put the fine-grained Actions: Read token in host-only .deploy.env, copied
# from .deploy.env.example. Docker Compose must never receive that file.

# --- Release image retention (rollback window) ---
# After a successful deploy, server_up.sh keeps this many most recent
# brain-api:<sha> images plus any tag a container still references, and removes
# the rest. Raise it to keep a longer rollback history at the cost of disk.
BRAIN_IMAGE_RETENTION=5

# --- LLM / Embeddings ---
# Any OpenAI-compatible API works. Pick a preset (openai, nvidia, openrouter,
# groq, together, deepseek, mistral, ollama, lmstudio) or openai_compatible
# (aliases custom / openai-compatible) and, if needed, override with the
# universal settings. server_up.sh / doctor.sh require the key of whichever
# provider is selected (nvapi- prefix only for nvidia).
# E.g. https://openrouter.ai/api/v1 (must include /v1):
# LLM_BASE_URL=
# Overrides the preset key below; blank for keyless local endpoints:
# LLM_API_KEY=
# LLM_MODEL=
# SUMMARIZER_MODEL=
# Defaults to LLM_BASE_URL when both use the same provider:
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# Must match the existing pgvector column; changing it = full re-index:
# EMBEDDING_DIMENSION=
# EMBEDDING_MAX_INPUT_CHARS=
# EMBEDDING_BATCH_SIZE=
# Examples: OpenRouter -> DEFAULT_LLM_PROVIDER=openrouter + OPENROUTER_API_KEY;
#           Groq -> DEFAULT_LLM_PROVIDER=groq + GROQ_API_KEY;
#           Ollama -> DEFAULT_LLM_PROVIDER=ollama + LLM_BASE_URL=http://ollama:11434/v1 (no key).
#
# Production preset: NVIDIA NIM (4096-dim nv-embedcode embeddings already
# stored in pgvector - keep DEFAULT_EMBEDDING_PROVIDER=nvidia unless you plan a
# full re-index).
DEFAULT_LLM_PROVIDER=nvidia
DEFAULT_EMBEDDING_PROVIDER=nvidia
# REQUIRED in production - supplied at deploy time, never committed.
NVIDIA_API_KEY=
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedcode-7b-v1
NVIDIA_SUMMARIZER_MODEL=meta/llama-3.1-8b-instruct
# Per-task routing uses provider-specific model IDs (these are NVIDIA NIM IDs);
# clear or replace them when switching DEFAULT_LLM_PROVIDER.
LLM_TASK_CLASSIFICATION_MODEL=meta/llama-3.1-8b-instruct
LLM_TASK_SUMMARIZATION_MODEL=meta/llama-3.1-8b-instruct
LLM_TASK_SYNTHESIS_MODEL=meta/llama-3.1-70b-instruct
LLM_TASK_INSIGHT_MODEL=z-ai/glm-5.2

# --- Proactive insights (manual job is available; scheduled loop is opt-in) ---
PROACTIVE_INSIGHTS_ENABLED=true
PROACTIVE_INSIGHTS_LLM_ENABLED=false
PROACTIVE_INSIGHTS_MAX_SNAPSHOT_CHARS=16000
PROACTIVE_INSIGHTS_TIMEOUT_S=45
PROACTIVE_INSIGHTS_LLM_CACHE_TTL_SECONDS=604800

# --- Orchestration API auth (external triggers send X-API-Key) ---
# Strong token - generated by server_up.sh if left blank.
PROJECT_BRAIN_API_KEY=
# Shared only between GitHub Actions and POST /webhooks/git-merge; callers sign
# the raw body as X-Hub-Signature-256 = HMAC-SHA256(secret, body).
PROJECT_BRAIN_WEBHOOK_TOKEN=
WORKER_REDIS_PREFIX=brain:worker
WORKER_POOL_NAME=maintenance
# Keep both disabled until the measured shadow/canary gates pass. One context
# mode flag is the complete agent-runtime rollback; pool flag adds services.
BRAIN_AGENT_CONTEXT_V2_MODE=off
BRAIN_WORKER_POOLS_V2_ENABLED=false
AGENT_LOCATOR_MAX_BYTES=2400
AGENT_RUNTIME_CONTEXT_MAX_BYTES=14000
AGENT_ASK_INPUT_MAX_BYTES=18000
AGENT_ASK_OUTPUT_MAX_BYTES=2000
AGENT_IMPACT_MAX_BYTES=8000
AGENT_RETRIEVAL_DEADLINE_S=5
AGENT_CONTEXT_DEADLINE_S=8
AGENT_ASK_DEADLINE_S=25
AGENT_IMPACT_DEADLINE_S=10
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_HEARTBEAT_TTL_SECONDS=45
HARNESS_STALE_REAPER_ENABLED=true
HARNESS_STALE_REAPER_BATCH_SIZE=500

# --- Closed-loop LLM self-diagnosis and owner alerts ---
SELF_DIAGNOSIS_ENABLED=true
SELF_DIAGNOSIS_USE_LLM=true
SELF_DIAGNOSIS_JOB_MAX_ATTEMPTS=3
SELF_DIAGNOSIS_RESULT_TTL_SECONDS=604800
SELF_DIAGNOSIS_MIN_AVG_RECALL=0.70
TELEGRAM_ALERTS_ENABLED=true
# Required when self-diagnosis is enabled; never commit real values.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=21600
TELEGRAM_ALERT_TIMEOUT_S=20
BRAIN_TELEGRAM_DEFAULT_REPO=/app

# --- Web UI (apps/web, deployed separately) ---
# Public URL of the web UI. GET / reports it; /dashboard* redirects to it.
BRAIN_WEB_URL=

# --- Retrieval (production: Ranking v6 enabled - proven recall+ordering gains) ---
RETRIEVAL_V6_ENABLED=true
RETRIEVAL_V6_SEMANTIC_RERANK=true
# File cards require a card build after indexing; enable once cards are built.
RETRIEVAL_V6_FILE_CARDS_ENABLED=false
# LLM rerank stays off (provider latency/reliability unproven for structured rerank).
RETRIEVAL_USE_LLM_RERANK=false
RETRIEVAL_USE_LLM_CLASSIFICATION=false
ALLOW_EMBEDDING_JSON_FALLBACK=false

# --- Optional LFM2.5-ColBERT precision layer (inert by default) ---
LATE_INTERACTION_ENABLED=false
LATE_INTERACTION_DUAL_WRITE_ENABLED=false
LATE_INTERACTION_SHADOW_ENABLED=false
LATE_INTERACTION_SHADOW_PERSIST_ENABLED=true
LATE_INTERACTION_RERANK_ENABLED=false
LATE_INTERACTION_CANARY_PERCENT=0
LATE_INTERACTION_REMOTE_ENABLED=false
LATE_INTERACTION_ALLOW_REMOTE_PROVIDER=false
LATE_INTERACTION_REMOTE_URL=http://127.0.0.1:8090
LATE_INTERACTION_REMOTE_TOKEN=
LATE_INTERACTION_REMOTE_MODEL=LiquidAI/LFM2.5-ColBERT-350M
LATE_INTERACTION_REMOTE_MODEL_REVISION=59633c2e31717b3502343ff566bee9fda3261943
LATE_INTERACTION_REMOTE_EXPECTED_INDEX_REVISION=
LATE_INTERACTION_EXPERIMENT_AUTHORIZED=false
LATE_INTERACTION_PRODUCTION_GATES_PASSED=false
# Populate all seven only for the exact reviewed repo/release/model/index/evidence.
LATE_INTERACTION_APPROVED_REPOSITORY_ID=
LATE_INTERACTION_APPROVED_BUILD_SHA=
LATE_INTERACTION_APPROVED_SOURCE_DIGEST=
LATE_INTERACTION_APPROVED_MODEL_REVISION=
LATE_INTERACTION_APPROVED_INDEX_REVISION=
LATE_INTERACTION_APPROVED_LINEAGE_ID=
LATE_INTERACTION_APPROVED_IDENTITY_DIGEST=
LATE_INTERACTION_APPROVED_DOCUMENT_COUNT=
LATE_INTERACTION_PRODUCTION_EVIDENCE_PATH=
LATE_INTERACTION_PRODUCTION_EVIDENCE_SHA256=

# --- Scheduler (inside the worker; replaces n8n) ---
SCHEDULER_ENABLED=true
SCHEDULER_CATCHUP_WINDOW_S=21600
SCHEDULER_STALE_GRACE_S=7200
SCHEDULER_JOB_MAX_ATTEMPTS=3
# Optional dead-man switch URLs, pinged after each successful run.
DEADMAN_URL_NIGHTLY_MAINTENANCE=
DEADMAN_URL_HEALTH_CHECK=
DEADMAN_URL_SELF_DIAGNOSIS=
DEADMAN_URL_BENCHMARK=
PROJECT_BRAIN_GIT_REPO_PATH=/app
